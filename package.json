{
  "name": "ghazi-saoudi-xp-portfolio",
  "version": "1.0.2",
  "private": false,
  "author": "Ghazi Saoudi",
  "license": "MIT",
  "homepage": "https://ghazi-saoudi.vercel.app",
  "scripts": {
    "dev": "vite --host",
    "sass": "sass --watch sass/main.scss:css/main.css",
    "dev:all": "npm-run-all --parallel dev sass",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "check:content": "node scripts/verify-portfolio.mjs",
    "check:pdf-navigation": "node scripts/verify-pdf-navigation.mjs",
    "check:project-files": "node scripts/verify-project-files.mjs",
    "check:doom": "node scripts/verify-doom.mjs",
    "check:paint": "node scripts/verify-paint.mjs",
    "check:gift": "node scripts/verify-gift.mjs",
    "check:computer": "node scripts/verify-computer.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "check:contact": "node --test tests/contact.test.mjs tests/server.test.mjs",
    "check:documents": "node scripts/verify-documents.mjs",
    "check:spider": "node scripts/verify-spider.mjs",
    "check:session": "node scripts/verify-session.mjs",
    "check:assistant": "node --test tests/chat.test.mjs",
    "check:performance": "node --test tests/performance.test.mjs",
    "report:performance": "node scripts/report-performance.mjs"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@vueuse/head": "^0.9.8",
    "pdfjs-dist": "^5.7.284",
    "pinia": "^3.0.4",
    "vue": "^3.5.27",
    "vue-i18n": "^11.2.8",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@intlify/message-compiler": "^11.1.3",
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@rushstack/eslint-patch": "^1.3.3",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitejs/plugin-vue-jsx": "^5.1.3",
    "@vue/eslint-config-prettier": "^8.0.0",
    "autoprefixer": "^10.4.20",
    "baseline-browser-mapping": "^2.9.17",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "^10.11.1",
    "geckodriver": "^4.2.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.30",
    "prettier": "^3.0.3",
    "sass": "^1.72.0",
    "ts-node": "^10.9.1",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.5",
    "wait-on": "^7.0.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
